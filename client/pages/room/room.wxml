<!--pages/room/room.wxml-->
<view class="container">
  <view class="my-nickname" wx:if="{{myNickname}}">你的昵称：<text class="my-nickname-text">{{myNickname}}</text></view>
  <view class="room-info">房间号: {{roomId}}</view>
  
  <view class="players-list">
    <view class="list-title">玩家列表 ({{players.length}})</view>
    <view wx:for="{{players}}" wx:key="id" class="player-item {{item.isReady ? 'ready' : ''}}">
      <text>{{item.nickname}}</text>
      <text>{{item.isReady ? '已准备' : '未准备'}}</text>
    </view>
  </view>

  <view class="spectators-list" wx:if="{{spectators.length > 0}}">
    <view class="list-title">观众列表 ({{spectators.length}})</view>
    <view wx:for="{{spectators}}" wx:key="id" class="spectator-item">
      <text>{{item.nickname}}</text>
    </view>
  </view>

  <block wx:if="{{!isSpectator}}">
    <button class="button" bindtap="toggleReady">{{isReady ? '取消准备' : '准备'}}</button>
    <block wx:if="{{isCreator}}">
      <button class="button start-button" type="primary" bindtap="startGame">开始游戏</button>
    </block>
    <button class="button share-button" open-type="share">邀请好友</button>
  </block>


  <!-- leave button visible to everyone (including spectators) -->
  <button class="button leave-button" bindtap="leaveRoom">退出房间</button>

</view>