
/* pages/room/room.wxss */
.container {
  padding: 40rpx;
  min-height: 100vh;
  background-color: #FAFAFA;
}

.room-info {
  font-size: 44rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
  color: #F9A825; /* Warm Gold */
  padding: 30rpx;
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* NEW: Game configuration display */
.game-config {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  padding: 20rpx;
  background-color: #E1F5FE;
  border-radius: 12rpx;
}

.players-list {
  width: 100%;
  margin-bottom: 60rpx;
}

.list-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.player-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.player-item.ready {
  background: linear-gradient(135deg, #E1F5FE 0%, #B3E5FC 100%); /* Peaceful Blue gradient */
  border-color: #4FC3F7;
  box-shadow: 0 4rpx 16rpx rgba(79, 195, 247, 0.3);
  color: #01579B;
  font-weight: 500;
}

.button {
  width: 100%;
  margin-top: 20rpx;
}

.start-button {
  background-color: #F9A825; /* Warm Gold */
  color: white;
}
