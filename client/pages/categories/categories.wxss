/* pages/categories/categories.wxss */
.container {
  padding: 40rpx;
  min-height: 100vh;
  background-color: #FAFAFA;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
  color: #F9A825;
}

.notice {
  text-align: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 60rpx;
  padding: 20rpx;
  background-color: #FFF9E6;
  border-radius: 12rpx;
}

.categories-list {
  width: 100%;
}

.category-section {
  margin-bottom: 24rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.category-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  cursor: pointer;
  transition: background-color 0.3s;
}

.category-header:active {
  background-color: #FFF9E6;
}

.category-name {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #F9A825;
}

.category-count {
  font-size: 28rpx;
  color: #999;
  margin-right: 16rpx;
}

.chevron {
  font-size: 24rpx;
  color: #F9A825;
  transition: transform 0.3s ease;
}

.chevron.expanded {
  transform: rotate(180deg);
}

.category-content {
  overflow: hidden;
  transition: max-height 0.3s ease, opacity 0.3s ease;
}

.category-content.collapsed {
  max-height: 0;
  opacity: 0;
}

.category-content.expanded {
  max-height: 2000rpx;
  opacity: 1;
}

.word-pair-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  margin: 0 24rpx 24rpx 24rpx;
  background-color: #FAFAFA;
  border-radius: 12rpx;
}

.word-pair-item:last-child {
  margin-bottom: 24rpx;
}

.word {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  padding: 16rpx;
  border-radius: 12rpx;
}

.civilian-word {
  background-color: #E1F5FE;
  color: #01579B;
}

.undercover-word {
  background-color: #FFE0B2;
  color: #E65100;
}

.arrow {
  font-size: 36rpx;
  color: #F9A825;
  margin: 0 16rpx;
  font-weight: bold;
}
