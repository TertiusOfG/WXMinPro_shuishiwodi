
/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: linear-gradient(to bottom, #FAFAFA 0%, #F5F5F5 100%);
}

.title {
  font-size: 64rpx;
  font-weight: bold;
  margin-bottom: 100rpx;
  color: #F9A825; /* Warm Gold */
  text-shadow: 0 2rpx 8rpx rgba(249, 168, 37, 0.2);
  letter-spacing: 4rpx;
}

.input {
  width: 80%;
  height: 88rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 44rpx; /* Pill shape */
  padding: 0 32rpx;
  margin-bottom: 40rpx;
  background-color: white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  font-size: 30rpx;
  transition: all 0.3s ease;
}

.input:focus {
  border-color: #4FC3F7;
  box-shadow: 0 4rpx 16rpx rgba(79, 195, 247, 0.2);
}

.button {
  width: 80%;
  margin-bottom: 24rpx;
}

.join-section {
  display: flex;
  width: 80%;
  margin-top: 60rpx;
  align-items: center;
}

.room-input {
  flex-grow: 1;
  margin-right: 20rpx;
  margin-bottom: 0;
}

.join-button {
  width: auto;
  flex-shrink: 0;
  padding: 0 40rpx;
}
