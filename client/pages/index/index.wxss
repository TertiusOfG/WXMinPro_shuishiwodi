
/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: linear-gradient(to bottom, #FAFAFA 0%, #F5F5F5 100%);
}

.title {
  font-size: 72rpx;
  font-weight: bold;
  margin-bottom: 240rpx;
  color: #F9A825; /* Warm Gold */
  text-shadow: 0 2rpx 8rpx rgba(249, 168, 37, 0.2);
  letter-spacing: 6rpx;
}

.main-button {
  width: 70%;
  height: 80rpx;
  margin-bottom: 32rpx;
  border-radius: 48rpx;
  font-size: 36rpx;
  font-weight: bold;
}

.link-text {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #4FC3F7; /* Heavenly Blue */
  text-decoration: underline;
  cursor: pointer;
}

/* Modal Styles */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  background-color: white;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 32rpx;
  color: #F9A825;
}

/* NEW: Modal profile section with avatar */
.modal-profile-section {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 28rpx;
  gap: 16rpx;
}

.modal-avatar-button {
  width:80rpx !important;
  height: 80rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background-color: #4FC3F7;
}

.modal-avatar-button::after {
  border: none;
}

.modal-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid #E0E0E0;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 40rpx;
  padding: 0 28rpx;
  margin-bottom: 28rpx;
  background-color: #FAFAFA;
  font-size: 28rpx;
}

.modal-input-room {
  height: 80rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 40rpx;
  padding: 0 28rpx;
  margin-bottom: 28rpx;
  background-color: #FAFAFA;
  font-size: 28rpx;
}

/* Adjust input in profile section */
.modal-profile-section .modal-input {
  flex: 1;
  margin-bottom: 0;
}

.checkbox-label {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  font-size: 28rpx;
  color: #666;
}

.checkbox-label checkbox {
  margin-right: 12rpx;
}

.modal-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.modal-button {
  width: 45%;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 30rpx;
}

.cancel-button {
  background-color: #E0E0E0;
  color: #666;
}

.confirm-button {
  background-color: #F9A825;
}
