<!--pages/index/index.wxml-->
<view class="container">
  <view class="title">谁是卧底</view>

  <button class="main-button" type="primary" bindtap="goToSetup">马上开始</button>
  
  <button class="main-button" type="default" bindtap="showJoinModal">输入房间号</button>

  <view class="link-text" bindtap="goToCategories">查看词汇列表</view>
</view>

<!-- Join Room Modal -->
<view class="modal-overlay" wx:if="{{showModal}}" bindtap="hideJoinModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-title">加入房间</view>
    
    <!-- NEW: Profile section with avatar and nickname -->
    <view class="modal-profile-section">
      <button class="modal-avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="modal-avatar" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      </button>
      <input class="modal-input" type="nickname" placeholder="输入昵称" bindinput="onNicknameInput" value="{{nickname}}" />
    </view>
    
    <input class="modal-input" placeholder="输入房间号" bindinput="onRoomIdInput" value="{{roomId}}" />
    
    <view class="checkbox-label">
      <checkbox value="true" checked="{{isSpectator}}" bindchange="onSpectatorChange" />
      <text>以观众身份加入</text>
    </view>
    
    <view class="modal-buttons">
      <button class="modal-button cancel-button" bindtap="hideJoinModal">取消</button>
      <button class="modal-button confirm-button" type="primary" bindtap="joinRoom">确定</button>
    </view>
  </view>
</view>
