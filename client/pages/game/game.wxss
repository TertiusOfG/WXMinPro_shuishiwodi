/* pages/game/game.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  min-height: 100vh;
  background-color: #FAFAFA;
}

.word-display-area {
  width: 90%;
  padding: 48rpx;
  margin-bottom: 40rpx;
  background: linear-gradient(135deg, #FFF9E6 0%, #FFF3D0 100%); /* Parchment/Scripture card look */
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(249, 168, 37, 0.15);
  border: 2rpx solid #F9A825;
}

.word-label {
  font-size: 26rpx;
  color: #8D6E63;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.word {
  font-size: 64rpx;
  font-weight: bold;
  color: #5D4037;
  letter-spacing: 4rpx;
}

.game-status {
  margin-bottom: 40rpx;
  font-size: 32rpx;
  color: #4FC3F7; /* Heavenly Blue */
  font-weight: 500;
}

.players-grid {
  position: relative;
  width: 360rpx;
  height: 360rpx;
  margin-bottom: 40rpx;
}

.player-card {
  position: absolute;
  width: 150rpx;
  height: 150rpx;
  background-color: white;
  border-radius: 50%; /* Make it a circle */
  display: flex;
  flex-direction: column;
  justify-content: flex-end; /* Align content to bottom for overlay */
  align-items: center;
  text-align: center;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  border: 3rpx solid #E0E0E0;
  overflow: hidden; /* Ensure avatar doesn't overflow circle */
}

.player-avatar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

.player-nickname-overlay {
  position: relative;
  width: 100%;
  padding: 8rpx 4rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0));
  border-radius: 0 0 75rpx 75rpx; /* Match bottom half of circle */
  z-index: 1;
}

.player-nickname {
  font-size: 24rpx;
  color: white;
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 4rpx;
}

.player-status {
  font-size: 20rpx;
  color: #FFB74D;
  font-weight: 600;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.5);
}

.action-area {
  width: 90%;
}

.button {
  width: 100%;
}

.player-card.eliminated {
  opacity: 0.4;
  border-color: #BDBDBD;
}

.player-card.eliminated .player-avatar {
  filter: grayscale(100%);
}

.voting-active .player-card:not(.eliminated) {
  cursor: pointer;
}

.voting-active .player-card.selected {
  transform: scale(1.15);
  box-shadow: 0 0 20rpx rgba(79, 195, 247, 0.6);
  border: 4rpx solid #4FC3F7;
}

/* Style for the current player's turn - Golden Halo */
.player-card.current-turn {
  transform: scale(1.15);
  box-shadow: 0 0 24rpx rgba(249, 168, 37, 0.7);
  border: 4rpx solid #F9A825;
}

/* --- Speeches Area --- */
.speeches-area {
  width: 90%;
  height: 300rpx;
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 2rpx solid #E0E0E0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.speech-row {
  display: flex;
  align-items: flex-start;  /* Align items to top */
  margin-bottom: 24rpx;
  gap: 12rpx;  /* Space between avatar and bubble */
}

/* NEW: Avatar styles */
.speech-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid #E0E0E0;
  flex-shrink: 0;  /* Prevent avatar from shrinking */
}

.my-speech-row {
  justify-content: flex-end;
}

.other-speech-row {
  justify-content: flex-start;
}

.speech-bubble {
  max-width: 70%;
  padding: 18rpx 28rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
}

.my-speech-bubble {
  background-color: #E1F5FE; /* Gentle Blue */
  color: #01579B;
  border-bottom-right-radius: 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(79, 195, 247, 0.15);
}

.other-speech-bubble {
  background-color: #FFFFFF;
  color: #333333;
  border: 2rpx solid #E0E0E0;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.speech-nickname {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  color: #666;
}

.my-speech-bubble .speech-nickname {
  color: #0277BD;
  text-align: right;
}

.speech-message {
  font-size: 28rpx;
  word-wrap: break-word;
  line-height: 1.5;
}

.speech-input {
  border: 2rpx solid #E0E0E0;
  border-radius: 24rpx;
  padding: 18rpx 28rpx;
  width: 100%;
  margin-bottom: 12rpx;
  background-color: white;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.speech-input:focus {
  border-color: #4FC3F7;
  box-shadow: 0 2rpx 12rpx rgba(79, 195, 247, 0.2);
}
