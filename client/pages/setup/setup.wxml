<!--pages/setup/setup.wxml-->
<view class="container">
  <view class="title">游戏设置</view>

  <view class="config-section">
    <view class="config-item">
      <text class="config-label">玩家总人数</text>
      <picker class="config-picker" mode="selector" range="{{playerCountOptions}}" value="{{playerCountIndex}}" bindchange="onPlayerCountChange">
        <view class="picker-display">{{maxPlayers}}</view>
      </picker>
    </view>

    <view class="config-item">
      <text class="config-label">卧底人数</text>
      <picker class="config-picker" mode="selector" range="{{undercoverOptions}}" value="{{undercoverIndex}}" bindchange="onUndercoverChange">
        <view class="picker-display">{{undercoverCount}}</view>
      </picker>
    </view>

    <view class="config-item">
      <text class="config-label">词汇类别</text>
      <picker class="config-picker category-picker" mode="selector" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-display category-picker-display">{{selectedCategory}}</view>
      </picker>
    </view>
    
    <!-- NEW: Hint text for valid range -->
    <view class="hint-text">
      <text>卧底人数范围: {{minUndercover}}-{{maxUndercover}}</text>
    </view>
  </view>

  <!-- NEW: User profile section with avatar and nickname -->
  <view class="profile-section">
    <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
    </button>
    <input class="nickname-input" type="text" placeholder="输入昵称" bindinput="onNicknameInput" value="{{nickname}}" />
  </view>

  <button class="start-button" type="primary" bindtap="createGame">开 局</button>
</view>
