/* pages/setup/setup.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: linear-gradient(to bottom, #FAFAFA 0%, #F5F5F5 100%);
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 80rpx;
  color: #F9A825; /* Warm Gold */
  text-shadow: 0 2rpx 8rpx rgba(249, 168, 37, 0.2);
}

.config-section {
  width: 80%;
  margin-bottom: 60rpx;
}

.config-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.config-label {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

/* NEW: Picker styles */
.config-picker {
  width: 120rpx;
}

.picker-display {
  width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 32rpx;
  background-color: #FAFAFA;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Category picker - wider than default */
.category-picker {
  width: 200rpx;
}

.category-picker-display {
  width: 200rpx;
}

/* Hint text for valid range */
.hint-text {
  text-align: center;
  font-size: 24rpx;
  color: #4FC3F7; /* Heavenly Blue */
  margin-top: -12rpx;
  margin-bottom: 20rpx;
}

/* NEW: Profile section with avatar and nickname */
.profile-section {
  display: flex;
  align-items: center;
  width: 80%;
  margin-bottom: 60rpx;
  gap: 20rpx;
}

.avatar-button {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-button::after {
  border: none;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 2rpx solid #E0E0E0;
}

.nickname-input {
  flex: 1;
  height: 88rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 44rpx;
  padding: 0 32rpx;
  background-color: white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  font-size: 30rpx;
}

.start-button {
  width: 80%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 36rpx;
  font-weight: bold;
}
